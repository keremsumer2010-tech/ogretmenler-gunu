{
  "rules": {
    "votes": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$q": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "$q.matches(/^[0-9]{1,2}$/) && newData.hasChildren(['k','t']) && newData.child('k').isNumber() && (newData.child('k').val() === 0 || newData.child('k').val() === 1) && newData.child('t').val() === now"
        }
      }
    },
    "reveal": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$q": {
        ".validate": "$q.matches(/^[0-9]{1,2}$/) && newData.isBoolean()"
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    }
  }
}
